{
  "$defs": {
    "HITLMode": {
      "enum": [
        "AUTO",
        "REVIEW",
        "INTERACTIVE"
      ],
      "title": "HITLMode",
      "type": "string"
    },
    "MissingInput": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "classification": {
          "pattern": "^(essential|defaultable|free_variable)$",
          "title": "Classification",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "name",
        "classification",
        "reason"
      ],
      "title": "MissingInput",
      "type": "object"
    },
    "Parameter": {
      "additionalProperties": false,
      "description": "Numbers require an explicit Quantity, including dimensionless values.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quantity"
            },
            {
              "minLength": 1,
              "type": "string"
            }
          ],
          "title": "Value"
        },
        "provenance": {
          "$ref": "#/$defs/Provenance"
        }
      },
      "required": [
        "name",
        "value",
        "provenance"
      ],
      "title": "Parameter",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "$ref": "#/$defs/SourceType"
        },
        "source_ref": {
          "minLength": 1,
          "title": "Source Ref",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "source_type",
        "source_ref"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Quantity": {
      "additionalProperties": false,
      "description": "Finite scalar with a unit; normalized to SI when constructed.\n\nAbsolute temperatures use Temperature; differences use TemperatureDifference.\nGeneric quantities allow dimensionless metrics but never implicit units.",
      "properties": {
        "value": {
          "title": "Value",
          "type": "number"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "title": "Quantity",
      "type": "object"
    },
    "SourceType": {
      "enum": [
        "USER",
        "PRODUCT_DB",
        "DESIGN_GUIDELINE",
        "PHYSICS_DERIVED",
        "OPTIMIZED",
        "AGENT_ASSUMPTION",
        "HUMAN_CONFIRMED"
      ],
      "title": "SourceType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "raw_prompt": {
      "minLength": 1,
      "title": "Raw Prompt",
      "type": "string"
    },
    "parameters": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Parameter"
      },
      "title": "Parameters",
      "type": "array"
    },
    "missing": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MissingInput"
      },
      "title": "Missing",
      "type": "array"
    },
    "requested_objective": {
      "anyOf": [
        {
          "$ref": "#/$defs/Parameter"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "mandatory_components": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Mandatory Components",
      "type": "array"
    },
    "forbidden_components": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Forbidden Components",
      "type": "array"
    },
    "hitl_mode": {
      "$ref": "#/$defs/HITLMode"
    }
  },
  "required": [
    "raw_prompt",
    "hitl_mode"
  ],
  "title": "UserRequirements",
  "type": "object"
}
